TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin configuration:
# Place your 'firebase-service-account.json' private key file directly in the root of the telegram-bot folder.
# The app automatically detects and uses it to connect to Firestore. If not present, the bot defaults to a mock in-memory rate-limiter.
