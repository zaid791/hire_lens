# Local development — copy to .env.local and fill in your values.
# Never commit .env.local with real secrets.

APP_URL=http://localhost:5173

# Firebase Web SDK (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Required when using Gemini locally (model_provider=gemini)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Telegram bot @username (without @) — for Connect Telegram from dashboard
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Optional: opensource model variant
# VITE_MODEL_PROVIDER=opensource
# VITE_INFERENCE_URL=http://localhost:8081
