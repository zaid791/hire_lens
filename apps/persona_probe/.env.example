# Gemini API key used for profile analysis.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Local app URL used for auth and callbacks.
APP_URL="http://localhost:3000"

# Firebase client configuration for the PersonaProbe web app.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional GitHub OAuth values, if you wire up GitHub auth locally.
VITE_GH_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GH_SECRET_ID="YOUR_GITHUB_SECRET_ID"